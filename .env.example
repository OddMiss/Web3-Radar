# Telegram bot created with @BotFather and the target group/channel ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated USD stablecoins to monitor.
STABLECOINS=USDT,USDC,FDUSD,USDE,DAI,PYUSD,TUSD,USDP,USD1,USDG,RLUSD
MONITOR_INTERVAL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=20
DATABASE_PATH=data/web3_radar.sqlite3
HEALTH_FILE_PATH=data/last_run.json

# Binance public website data covers flexible products. Add a read-only key
# to also monitor the official locked-products API.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bitget Savings product discovery requires a read-only API key.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Optional regional API hosts. Keep the defaults unless your account region
# requires another official host.
BINANCE_API_BASE=https://api.binance.com
BINANCE_WEB_BASE=https://www.binance.com
BITGET_API_BASE=https://api.bitget.com
BYBIT_API_BASE=https://api.bybit.com
OKX_API_BASE=https://www.okx.com
